{
  "name": "@angular-bootstrap/xlsx",
  "version": "0.1.0-rc.1",
  "author": "sheetjs",
  "description": "Independent local SheetJS CE review candidate; not an official SheetJS release",
  "keywords": [
    "excel",
    "xls",
    "xlsx",
    "xlsb",
    "xlsm",
    "ods",
    "csv",
    "dbf",
    "dif",
    "sylk",
    "office",
    "spreadsheet"
  ],
  "main": "xlsx.js",
  "module": "xlsx.mjs",
  "unpkg": "dist/xlsx.full.min.js",
  "jsdelivr": "dist/xlsx.full.min.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./xlsx.mjs",
      "require": "./xlsx.js"
    },
    "./xlsx.mjs": {
      "types": "./types/index.d.ts",
      "import": "./xlsx.mjs"
    },
    "./xlsx.js": {
      "types": "./types/index.d.ts",
      "require": "./xlsx.js"
    },
    "./dist/xlsx.core.min": {
      "types": "./types/index.d.ts",
      "import": "./dist/xlsx.core.min.js",
      "require": "./dist/xlsx.core.min.js"
    },
    "./dist/xlsx.core.min.js": {
      "types": "./types/index.d.ts",
      "import": "./dist/xlsx.core.min.js",
      "require": "./dist/xlsx.core.min.js"
    },
    "./dist/xlsx.full.min": {
      "types": "./types/index.d.ts",
      "import": "./dist/xlsx.full.min.js",
      "require": "./dist/xlsx.full.min.js"
    },
    "./dist/xlsx.full.min.js": {
      "types": "./types/index.d.ts",
      "import": "./dist/xlsx.full.min.js",
      "require": "./dist/xlsx.full.min.js"
    },
    "./dist/xlsx.mini.min": {
      "types": "./types/index.d.ts",
      "import": "./dist/xlsx.mini.min.js",
      "require": "./dist/xlsx.mini.min.js"
    },
    "./dist/xlsx.mini.min.js": {
      "types": "./types/index.d.ts",
      "import": "./dist/xlsx.mini.min.js",
      "require": "./dist/xlsx.mini.min.js"
    },
    "./dist/xlsx.zahl": {
      "types": "./dist/zahl.d.ts",
      "import": "./dist/xlsx.zahl.mjs",
      "require": "./dist/xlsx.zahl.js"
    },
    "./dist/xlsx.zahl.mjs": {
      "types": "./dist/zahl.d.ts",
      "import": "./dist/xlsx.zahl.mjs"
    },
    "./dist/xlsx.zahl.js": {
      "types": "./dist/zahl.d.ts",
      "require": "./dist/xlsx.zahl.js"
    },
    "./dist/cpexcel": {
      "types": "./dist/cpexcel.d.ts",
      "import": "./dist/cpexcel.full.mjs",
      "require": "./dist/cpexcel.js"
    },
    "./dist/cpexcel.js": {
      "types": "./dist/cpexcel.d.ts",
      "require": "./dist/cpexcel.js"
    },
    "./dist/cpexcel.full": {
      "types": "./dist/cpexcel.d.ts",
      "import": "./dist/cpexcel.full.mjs",
      "require": "./dist/cpexcel.js"
    },
    "./dist/cpexcel.full.mjs": {
      "types": "./dist/cpexcel.d.ts",
      "import": "./dist/cpexcel.full.mjs"
    }
  },
  "browser": {
    "buffer": false,
    "crypto": false,
    "stream": false,
    "process": false,
    "fs": false
  },
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {},
  "scripts": {
    "pretest": "npm run lint",
    "test": "npm run tests-only",
    "pretest-only": "git submodule init && git submodule update",
    "tests-only": "make travis",
    "build": "make",
    "lint": "make fullint",
    "dtslint": "dtslint types",
    "test:community": "node community/verify.cjs",
    "prepublishOnly": "node community/block-publish.cjs"
  },
  "config": {
    "blanket": {
      "pattern": "xlsx.js"
    }
  },
  "alex": {
    "allow": [
      "chinese",
      "special",
      "simple",
      "just",
      "crash",
      "wtf",
      "holes"
    ]
  },
  "homepage": "https://github.com/angular-bootstrap/xlsx-community#readme",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "bower.json",
    "package.json",
    "xlsx.js",
    "xlsx.mjs",
    "xlsxworker.js",
    "dist/LICENSE",
    "dist/*.mjs",
    "dist/*.js",
    "dist/*.map",
    "dist/*.d.ts",
    "types/index.d.ts",
    "types/tsconfig.json",
    "README.upstream.md",
    "COMMUNITY_PROVENANCE.json",
    "community/block-publish.cjs",
    "community/REVIEW_RESULTS.md",
    "community/RELEASE_CHECKS.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES/*.txt",
    "community/MINIFIED_LICENSE_SECURITY_REVIEW.md",
    "community/HTML_FIX_RESULTS.md",
    "MAPPING_DATA_NOTICES.md",
    "community/PROVENANCE_REPLACEMENT_RESULTS.md",
    "community/mapping-inputs/lock.json",
    "community/RESTORED_CODEPAGE_RESULTS.md",
    "community/CP895_COMPATIBILITY.md",
    "community/NODE_BUNDLER_RESULTS.md",
    "SECURITY.md",
    "community/UPSTREAM_DIFFERENCES.md",
    "community/ANGULAR_BOOTSTRAP_RELEASE_RESULTS.md",
    "community/RELEASE_PLAN.md",
    "community/public-evidence/*.json"
  ],
  "license": "(Apache-2.0 AND Unicode-3.0 AND MIT)",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angular-bootstrap/xlsx-community.git"
  },
  "bugs": {
    "url": "https://github.com/angular-bootstrap/xlsx-community/issues"
  }
}
